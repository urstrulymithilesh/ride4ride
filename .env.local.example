# ------------------------------------------------------------------
# Ride4Ride environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys.
# ------------------------------------------------------------------

# --- Supabase (Project Settings -> API) ---------------------------
# Safe to expose to the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never expose to the client.
# Used for privileged server actions (e.g. revealing addresses to a matched
# user, scheduled chat/post cleanup). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App -----------------------------------------------------------
# Canonical site URL (used for auth redirects & copy-link share URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Student (.edu) verification mode:
#   restrict = only allowed email domains may sign up (default)
#   badge    = anyone may sign up; allowed domains get a "verified" badge
# The allowed-domain LIST is configured in the DB table `allowed_email_domains`
# (seeded with '.edu'), so it's admin-editable without a redeploy.
EDU_VERIFICATION_MODE=restrict

# --- Maps / distance (Get-a-Ride geocoding + distance) -------------
# Mapbox access token. SERVER-ONLY (no NEXT_PUBLIC_ prefix) — used from
# Server Actions to geocode addresses and compute driving distance, so the
# token never reaches the browser. Get one at https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# --- Web Push (pre-expiry notifications) ---------------------------
# Generate a keypair once:  npx web-push generate-vapid-keys
# The public key is needed in the browser (NEXT_PUBLIC_) to subscribe;
# the private key is server-only and signs the push messages.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI sent to push services (mailto: or https:).
VAPID_SUBJECT=mailto:admin@ride4ride.com

# --- Rate limiting -------------------------------------------------
# Salt for hashing client IPs in the rate limiter. Server-only.
# Unsalted, an IPv4 hash is reversible by brute force (2^32 space), so
# this is what makes the stored value a pseudonym rather than personal
# data. Generate with:  openssl rand -hex 32
RATE_LIMIT_SALT=generate-a-long-random-string

# --- Cron (scheduled jobs) -----------------------------------------
# Shared secret. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET`; the cron routes reject anything else.
CRON_SECRET=generate-a-long-random-string
